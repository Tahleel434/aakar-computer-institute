{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Educational course offered by Aakar Computer Institute",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "duration": { "type": "string", "maxLength": 50 },
        "price": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "enum": ["programming", "design", "digital-marketing", "others"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "createdAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Student enquiry or counselling booking",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 20 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "course": { "type": "string", "minLength": 2, "maxLength": 100 },
        "preferredTimeSlot": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["new", "contacted", "converted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "email", "course", "status", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Student testimonial and rating",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "course": { "type": "string", "maxLength": 100 },
        "review": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "review", "rating", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Public educational course listings"
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Student enquiries submitted via website"
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Student testimonials and reviews"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Designated administrator permissions"
    }
  }
}
